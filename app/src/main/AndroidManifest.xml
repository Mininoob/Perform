<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Private library: talks only to the paired PC, over HTTPS with a pinned certificate. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".PreformApp"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Preform">

        <!-- Fetch the QR scanner with the app instead of on first use. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode_ui" />

        <!-- Samsung cover-screen continuity hints. -->
        <meta-data
            android:name="com.samsung.android.keepalive.density"
            android:value="true" />
        <meta-data
            android:name="com.samsung.android.multidisplay.keep_process_alive"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:configChanges="screenLayout|screenSize|smallestScreenSize|orientation|density|keyboardHidden|keyboard|navigation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Open with Preform" from file managers, mail, downloads. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>

        <!-- Folding must never recreate the reader: this list was verified on both
             the Z Flip 5 and the Z Fold 8. -->
        <activity
            android:name=".reader.ReaderActivity"
            android:exported="false"
            android:resizeableActivity="true"
            android:theme="@style/Theme.Preform.Reader"
            android:configChanges="screenLayout|screenSize|smallestScreenSize|orientation|density|keyboardHidden|keyboard|navigation|uiMode" />

        <activity
            android:name=".diagnostics.DiagnosticsActivity"
            android:exported="false"
            android:resizeableActivity="true"
            android:configChanges="screenLayout|screenSize|smallestScreenSize|orientation|density|keyboardHidden|keyboard|navigation|uiMode" />
    </application>

</manifest>
